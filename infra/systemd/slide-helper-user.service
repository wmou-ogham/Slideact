[Unit]
Description=Slideact (slide-helper) Docker Compose stack (user)
Documentation=https://github.com/slide-helper/slide-helper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/moriss/slide-helper
EnvironmentFile=-/home/moriss/slide-helper/.env
ExecStart=/home/moriss/slide-helper/scripts/compose-up.sh
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
