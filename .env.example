POSTGRES_DB=slide_helper
POSTGRES_USER=slide_helper
POSTGRES_PASSWORD=slide_helper_dev_only
RUST_LOG=slide_helper_api=info,slide_helper_worker=info,tower_http=info

# Google OpenID Connect. Configure all three values together.
# Example redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# Local HTTP development uses false. Production behind HTTPS must use true.
AUTH_COOKIE_SECURE=false
AUTH_FLOW_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=604800
